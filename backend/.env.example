# ================= 青禾 · AI 校园社区（后端） =================
# 复制为 .env 后按需修改。不要提交 .env 到仓库。

APP_NAME=青禾
APP_SUBTITLE=AI 校园社区
ENV=development

# 会话签名密钥；留空会自动生成并写入 backend/.secret
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 数据库 ----------
# 方式一（推荐）：直接给完整 URL
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/campus_ai_community?charset=utf8mb4
DATABASE_URL=

# 方式二：由下面 5 项自动拼装（DATABASE_URL 为空时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campus_ai_community

# 本地演示可临时用 SQLite（无需 MySQL）：
# DATABASE_URL=sqlite:///./data/campus.db

# ---------- 其他 ----------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 可选：DeepSeek 大模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
